generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum UserRole {
  CLIENTE
  ADMIN
  CHEF
  STAFF
  PROVEEDOR
  FINANZAS
}

enum OrderStatus {
  DRAFT
  QUOTED
  PAYMENT_PENDING
  PAID
  IN_PRODUCTION
  READY
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REVIEWED
}

enum EventType {
  CORPORATIVO
  BODA
  SOCIAL
  SUSCRIPCION
  PRIVADO
}

enum EventStatus {
  PLANNING
  CONFIRMED
  IN_PREPARATION
  READY
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PSE
  NEQUI
  CASH_ON_DELIVERY
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  COMPLETED
}

enum SupplierOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum BusinessLine {
  CATERING
  PHARMA
  LIOFILIZADOS
}

enum PaymentProvider {
  WOMPI
  BOLD
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  PAYMENT_PENDING
  PAID
  EXPIRED
  REJECTED
  CONVERTED
}

enum TaxRegime {
  COMMON
  SIMPLE
}

enum MomentType {
  DBR
  RFG
  ALM
  GAL
  MEX
  COC
}

// ═══════════════════════════════════════════════════════════════
// AUTH & USERS
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  /// Vacío para usuarios "guest" creados al hacer checkout sin cuenta.
  /// Después del pago se les envía un email con token para set password.
  passwordHash  String    @default("")
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(CLIENTE)
  avatar        String?
  /// Los guest users empiezan con isActive=false. Se activan en el webhook
  /// cuando se confirma el pago de su primera orden.
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company         Company?        @relation("CompanyContact")
  ownedCompany    Company?        @relation("CompanyOwner")
  orders          Order[]
  events          Event[]
  staffAssignments StaffAssignment[]
  feedbacks       Feedback[]
  sessions        Session[]
  shopOrders      ShopOrder[]
  passwordResetTokens PasswordResetToken[]
  quotes          Quote[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ═══════════════════════════════════════════════════════════════
// COMPANIES (B2B)
// ═══════════════════════════════════════════════════════════════

model Company {
  id          String   @id @default(uuid())
  name        String
  nit         String?  @unique
  address     String?
  city        String?
  phone       String?
  ownerId     String   @unique
  contactId   String?  @unique
  creditLimit Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User  @relation("CompanyOwner", fields: [ownerId], references: [id])
  contact User? @relation("CompanyContact", fields: [contactId], references: [id])
  orders  Order[]
  events  Event[]

  @@map("companies")
}

// ═══════════════════════════════════════════════════════════════
// MENU & PRODUCTS
// ═══════════════════════════════════════════════════════════════

model MenuCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String   @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  image           String?
  basePrice       Decimal  @db.Decimal(10, 2)
  preparationTime Int      @default(30)
  servesMin       Int      @default(1)
  servesMax       Int      @default(100)
  isVegetarian    Boolean  @default(false)
  isVegan         Boolean  @default(false)
  isGlutenFree    Boolean  @default(false)
  allergens       String[]
  isActive        Boolean  @default(true)
  // — Cost designer fields —
  momentType         MomentType?
  servingSize        String?
  laborMinutes       Int          @default(15)
  difficultyFactor   Decimal      @default(1.0) @db.Decimal(4, 2)
  targetMarginPercent Decimal     @default(0.40) @db.Decimal(4, 3)
  // —
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  ingredients MenuItemIngredient[]
  orderItems  OrderItem[]

  @@map("menu_items")
}

model Ingredient {
  id          String   @id @default(uuid())
  name        String
  unit        String
  costPerUnit Decimal  @db.Decimal(10, 2)
  stock       Decimal  @default(0) @db.Decimal(10, 2)
  minStock    Decimal  @default(0) @db.Decimal(10, 2)
  supplierId  String?
  isActive    Boolean  @default(true)
  // — Cost designer fields —
  /// Factor de rendimiento usable (1 - merma). 0.95 = 5% de pérdida.
  yieldPercent Decimal @default(0.95) @db.Decimal(4, 3)
  /// Categoría usada en el selector del backoffice ("Proteína", "Vegetal", etc.)
  category    String?
  // —
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier          Supplier?            @relation(fields: [supplierId], references: [id])
  menuItems         MenuItemIngredient[]
  supplierOrderItems SupplierOrderItem[]

  @@map("ingredients")
}

model MenuItemIngredient {
  id           String  @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Decimal @db.Decimal(10, 3)

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
  @@map("menu_item_ingredients")
}

// ═══════════════════════════════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════════════════════════════

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  userId           String
  companyId        String?
  eventId          String?
  /// Trazabilidad: si la orden nace de una Quote del diseñador.
  quoteId          String?     @unique
  status           OrderStatus @default(DRAFT)
  subtotal         Decimal     @db.Decimal(12, 2)
  tax              Decimal     @default(0) @db.Decimal(12, 2)
  discount         Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  guestCount       Int         @default(1)
  deliveryDate     DateTime
  deliveryTime     String
  deliveryAddress  String
  deliveryCity     String?
  notes            String?
  dietaryNotes     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  company    Company?   @relation(fields: [companyId], references: [id])
  event      Event?     @relation(fields: [eventId], references: [id])
  quote      Quote?     @relation(fields: [quoteId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  production Production?
  delivery   Delivery?
  invoice    Invoice?
  feedback   Feedback?

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  menuItemId   String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)
  customNotes  String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

// ═══════════════════════════════════════════════════════════════
// EVENTS
// ═══════════════════════════════════════════════════════════════

model Event {
  id          String      @id @default(uuid())
  userId      String
  companyId   String?
  name        String
  type        EventType
  status      EventStatus @default(PLANNING)
  date        DateTime
  startTime   String
  endTime     String?
  location    String
  guestCount  Int
  description String?
  budget      Decimal?    @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  orders  Order[]
  timeline EventTimeline[]
  staffAssignments StaffAssignment[]

  @@map("events")
}

model EventTimeline {
  id          String   @id @default(uuid())
  eventId     String
  time        String
  title       String
  description String?
  sortOrder   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_timelines")
}

// ═══════════════════════════════════════════════════════════════
// PAYMENTS (WOMPI)
// ═══════════════════════════════════════════════════════════════

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          PaymentProvider @default(BOLD)
  wompiTransactionId String?      @unique
  wompiReference    String?       @unique
  boldTransactionId String?       @unique
  boldReference     String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("COP")
  method            PaymentMethod?
  status            PaymentStatus @default(PENDING)
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════
// PRODUCTION (KITCHEN)
// ═══════════════════════════════════════════════════════════════

model Production {
  id          String           @id @default(uuid())
  orderId     String           @unique
  status      ProductionStatus @default(PENDING)
  assignedTo  String?
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("productions")
}

// ═══════════════════════════════════════════════════════════════
// LOGISTICS & DELIVERY
// ═══════════════════════════════════════════════════════════════

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  status         DeliveryStatus @default(PENDING)
  assignedTo     String?
  vehicleInfo    String?
  estimatedTime  DateTime?
  departedAt     DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

model StaffAssignment {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String
  notes     String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("staff_assignments")
}

// ═══════════════════════════════════════════════════════════════
// FINANCE
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  tax           Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  issuedAt      DateTime @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

// ═══════════════════════════════════════════════════════════════
// SUPPLIERS
// ═══════════════════════════════════════════════════════════════

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  nit         String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients   Ingredient[]
  supplierOrders SupplierOrder[]

  @@map("suppliers")
}

model SupplierOrder {
  id          String              @id @default(uuid())
  supplierId  String
  status      SupplierOrderStatus @default(DRAFT)
  totalAmount Decimal?            @db.Decimal(12, 2)
  notes       String?
  orderedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    SupplierOrderItem[]

  @@map("supplier_orders")
}

model SupplierOrderItem {
  id              String  @id @default(uuid())
  supplierOrderId String
  ingredientId    String
  quantity        Decimal @db.Decimal(10, 2)
  unitPrice       Decimal @db.Decimal(10, 2)
  totalPrice      Decimal @db.Decimal(10, 2)

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("supplier_order_items")
}

// ═══════════════════════════════════════════════════════════════
// FEEDBACK
// ═══════════════════════════════════════════════════════════════

model Feedback {
  id          String   @id @default(uuid())
  orderId     String   @unique
  userId      String
  foodRating  Int
  serviceRating Int
  overallRating Int
  comment     String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

// ═══════════════════════════════════════════════════════════════
// E-COMMERCE (CANÁBICO & LIOFILIZADOS)
// ═══════════════════════════════════════════════════════════════

model ProductCategory {
  id           String       @id @default(uuid())
  businessLine BusinessLine
  name         String
  slug         String
  description  String?
  icon         String?
  image        String?
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  products Product[]

  @@unique([businessLine, slug])
  @@map("product_categories")
}

model Product {
  id           String       @id @default(uuid())
  businessLine BusinessLine
  categoryId   String
  name         String
  slug         String
  description  String?
  shortDesc    String?
  image        String?
  images       String[]
  icon         String?
  price        Decimal      @db.Decimal(10, 2)
  comparePrice Decimal?     @db.Decimal(10, 2)
  sku          String?      @unique
  weight       String?
  unit         String?
  stock        Int          @default(0)
  lowStock     Int          @default(5)
  tags         String[]
  badge        String?
  isFeatured   Boolean      @default(false)
  isActive     Boolean      @default(true)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category       ProductCategory  @relation(fields: [categoryId], references: [id])
  shopOrderItems ShopOrderItem[]

  @@unique([businessLine, slug])
  @@map("products")
}

model ShopOrder {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  businessLine    BusinessLine
  userId          String
  status          ShopOrderStatus @default(PENDING)
  subtotal        Decimal         @db.Decimal(12, 2)
  tax             Decimal         @default(0) @db.Decimal(12, 2)
  shipping        Decimal         @default(0) @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  shippingName    String
  shippingAddress String
  shippingCity    String
  shippingPhone   String
  shippingNotes   String?
  paymentProvider PaymentProvider @default(WOMPI)
  paymentMethod   PaymentMethod?
  wompiTransactionId String?      @unique
  wompiReference  String?         @unique
  boldTransactionId String?      @unique
  boldReference   String?         @unique
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingNumber  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  items ShopOrderItem[]

  @@map("shop_orders")
}

model ShopOrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  order   ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])

  @@map("shop_order_items")
}

// ═══════════════════════════════════════════════════════════════
// PRICING CONFIG (DISEÑADOR DE PRODUCTO · CATERING)
// ═══════════════════════════════════════════════════════════════

/// Singleton: hay una sola fila con id = "default".
/// Controla impuestos, mano de obra, CIF, transporte y retenciones.
model PricingConfig {
  id                          String     @id @default("default")
  taxRegime                   TaxRegime  @default(COMMON)
  vatRate                     Decimal    @default(0.19)  @db.Decimal(5, 4)
  /// Tarifa única RST aplicable a actividad de catering / restaurantes (~5.4%).
  simpleRate                  Decimal    @default(0.054) @db.Decimal(5, 4)
  /// Impuesto Nacional al Consumo (servicio en sitio = 8%). 0 si no aplica.
  incRate                     Decimal    @default(0.08)  @db.Decimal(5, 4)
  /// Mano de obra base (COP por hora del chef/staff).
  laborCostPerHour            Decimal    @default(18000) @db.Decimal(10, 2)
  /// Factor prestacional + parafiscales (1.60 ≈ +60% sobre salario base).
  laborBenefitFactor          Decimal    @default(1.60)  @db.Decimal(4, 2)
  /// Costos indirectos de fabricación como % del CMP.
  cifPercent                  Decimal    @default(0.08)  @db.Decimal(5, 4)
  /// Transporte base por evento (COP).
  transportBase               Decimal    @default(80000) @db.Decimal(10, 2)
  /// Costo marginal por km (no usado en MVP — placeholder para geocoding futuro).
  transportPerKm              Decimal    @default(2000)  @db.Decimal(10, 2)
  /// Margen objetivo por defecto sobre venta.
  defaultMarginPercent        Decimal    @default(0.40)  @db.Decimal(4, 3)
  /// Retención en la fuente declarante (servicios = 4%).
  reteFuenteRateDeclarante    Decimal    @default(0.04)  @db.Decimal(5, 4)
  /// Retención en la fuente NO declarante (servicios = 6%).
  reteFuenteRateNoDeclarante  Decimal    @default(0.06)  @db.Decimal(5, 4)
  /// ReteIVA (sobre el IVA generado) — agente retenedor común 15%.
  reteIvaRate                 Decimal    @default(0.15)  @db.Decimal(5, 4)
  updatedBy                   String?
  updatedAt                   DateTime   @updatedAt
  createdAt                   DateTime   @default(now())

  @@map("pricing_config")
}

/// Tarifas tributarias y de transporte por ciudad de operación.
model CityTaxRate {
  id                  String   @id @default(uuid())
  city                String   @unique
  /// ICA por mil. Bogotá servicios = 9.66 / 1000 = 0.00966.
  icaRate             Decimal  @default(0.00966) @db.Decimal(6, 5)
  /// ReteICA municipal sobre la base gravable.
  reteIcaRate         Decimal  @default(0.00966) @db.Decimal(6, 5)
  /// Recargo de transporte para esta ciudad (sumado al transportBase).
  transportSurcharge  Decimal  @default(0)       @db.Decimal(10, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("city_tax_rates")
}

/// Tabla de descuentos por número de comensales.
model VolumeDiscount {
  id              String   @id @default(uuid())
  minGuests       Int      @unique
  discountPercent Decimal  @db.Decimal(4, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("volume_discounts")
}

/// Modificadores estacionales (alta/regular/baja) por rango de fechas (mes/día).
model SeasonalRate {
  id            String   @id @default(uuid())
  name          String
  startMonth    Int
  startDay      Int
  endMonth      Int
  endDay        Int
  /// 1.15 = +15% (alta), 1.00 = neutro, 0.92 = -8% (baja).
  rateModifier  Decimal  @default(1.0) @db.Decimal(4, 3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("seasonal_rates")
}

/// Cotización emitida por el diseñador de producto. Es snapshot — todos los
/// montos calculados se persisten para auditoría y para que la conversión
/// a Order no dependa de cambios posteriores en PricingConfig.
model Quote {
  id                   String       @id @default(uuid())
  quoteNumber          String       @unique
  userId               String
  status               QuoteStatus  @default(DRAFT)
  // — Detalles del evento —
  eventType            EventType?
  momentTypes          MomentType[]
  guestCount           Int
  eventDate            DateTime
  eventTime            String
  eventCity            String
  eventAddress         String
  // — Composición (snapshot con customizaciones) —
  itemsJson            Json
  // — Desglose calculado —
  cmpTotal             Decimal      @db.Decimal(12, 2)
  cmoTotal             Decimal      @db.Decimal(12, 2)
  cifTotal             Decimal      @db.Decimal(12, 2)
  transportTotal       Decimal      @db.Decimal(12, 2)
  costTotal            Decimal      @db.Decimal(12, 2)
  marginAmount         Decimal      @db.Decimal(12, 2)
  subtotal             Decimal      @db.Decimal(12, 2)
  /// Descuento por volumen aplicado (puede ser 0).
  volumeDiscountAmount Decimal      @default(0) @db.Decimal(12, 2)
  /// Ajuste estacional (puede ser negativo si rateModifier < 1).
  seasonalAdjustment   Decimal      @default(0) @db.Decimal(12, 2)
  /// Base gravable después de ajustes (antes de impuestos).
  taxableBase          Decimal      @db.Decimal(12, 2)
  vatAmount            Decimal      @default(0) @db.Decimal(12, 2)
  incAmount            Decimal      @default(0) @db.Decimal(12, 2)
  icaAmount            Decimal      @default(0) @db.Decimal(12, 2)
  simpleAmount         Decimal      @default(0) @db.Decimal(12, 2)
  total                Decimal      @db.Decimal(12, 2)
  // — Retenciones informativas (cliente agente retenedor) —
  reteFuenteAmount     Decimal      @default(0) @db.Decimal(12, 2)
  reteIvaAmount        Decimal      @default(0) @db.Decimal(12, 2)
  reteIcaAmount        Decimal      @default(0) @db.Decimal(12, 2)
  netReceivable        Decimal      @db.Decimal(12, 2)
  // — Snapshot del config aplicado (para auditoría) —
  pricingConfigSnapshot Json
  // —
  expiresAt            DateTime
  notes                String?
  dietaryNotes         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  order Order?

  @@index([userId, status])
  @@map("quotes")
}
